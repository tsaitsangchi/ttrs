# 複製為 .env 後依環境修改
DATABASE_URL=postgres://ttrs:ttrs@localhost:5432/ttrs
TTRS_BDD_DATABASE_URL=postgres://ttrs:ttrs@localhost:5432/ttrs_test
TTRS_API_ADDR=127.0.0.1:3000
# 前端編譯時讀取：Web 版留空則走同源 /api（dx proxy / nginx）；桌面、行動版才需要
# TTRS_API_URL=https://erp.example.com
# 只有前端與 API 不同網域時才需要，逗號分隔
# TTRS_CORS_ORIGINS=https://other.example.com
RUST_LOG=info,tower_http=debug

# TipTop Oracle 唯讀工具（scripts/tiptop/tiptop.py）；只連 TOPTEST，建議使用唯讀帳號
# tnsnames 的 GSMC_TOPTEST = 10.10.130.188:1521/toptest
# TIPTOP_ORACLE_DSN=10.10.130.188:1521/toptest
# TIPTOP_ORACLE_USER=
# TIPTOP_ORACLE_PASSWORD=
# TIPTOP_ORACLE_SCHEMA=   # 選用，預設同帳號（TipTop 各營運中心一個 schema）
# TIPTOP_ORACLE_CLIENT_DIR=/opt/oracle/instantclient_19_29   # 選用；資料庫早於 12.1（DPY-3010）時需要，用 Instant Client 19
