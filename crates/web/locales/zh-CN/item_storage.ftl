# 料件默认仓储维护（TipTop aimi202；specs/features/aim/item_storage.feature）
istorage-breadcrumb = 库存管理 / Item Storage Maintenance
istorage-title = 料件默认仓储维护
istorage-list-title = 料件
istorage-detail-title = 料件 { $item } 的默认仓储
istorage-field-item = 料号
istorage-field-name = 品名
istorage-field-spec = 规格
istorage-field-version = 目前版本
istorage-field-source = 来源码
istorage-field-stock-unit = 库存单位
istorage-field-group = 分群码
istorage-field-warehouse = 仓库
istorage-field-warehouse-name = 仓库名称
istorage-field-location = 储位
istorage-field-location-name = 储位名称
istorage-field-max-qty = 最高存量
istorage-field-copy-to = 复制到料号
istorage-action-batch = 整批产生
istorage-dialog-new = 新增默认仓储
istorage-dialog-edit = 修改默认仓储 { $warehouse } { $location }
istorage-dialog-batch = 整批产生默认仓储
istorage-msg-saved = 已保存料件 { $item } 的默认仓储
istorage-msg-deleted = 已删除料件 { $item } 的一笔默认仓储
istorage-msg-copied = 已将料件 { $from } 的默认仓储复制到 { $to }
istorage-msg-batch-done = 整批产生完成：新增 { $inserted } 笔、略过 { $skipped } 笔
istorage-msg-no-storage = 尚无默认仓储
istorage-hint-query = 没有条件时只列已设置默认仓储的料件；输入料号可找到尚未设置的料件。
istorage-hint-detail = 停用的料件不可维护；仓库须为有效仓库。单头料件资料请到料件维护修改。
istorage-hint-location = 储位空白表示整个仓库；有填时须为该仓库的储位。
istorage-hint-max-qty = 最高存量空白表示不限制，有填时不可小于 0、最多 3 位小数。
istorage-hint-pattern = 可用 * 通配符，例如 A*
istorage-hint-batch = 替符合条件的有效料件加上同一组仓库储位；已有该组合的料件略过。
