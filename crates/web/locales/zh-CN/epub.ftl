# EPUB 轉 TXT（epub_to_text.feature）
epub-breadcrumb = 系统管理 / EPUB to Text
epub-title = EPUB 转 TXT
epub-hint = 选择一个或多个 EPUB 电子书，系统会转成纯文本并下载同名的 .txt 文件（UTF-8、Windows 换行）。文件不会保存在系统中；有加密（DRM）的书无法转换；单一文件上限 50 MB。
epub-action-choose = 选择 EPUB 文件
epub-msg-running = 转换中…
epub-msg-done = { $file }：已下载（{ $title }／{ $author }，{ $chapters } 章）
epub-msg-failed = { $file }：转换失败，{ $error }
